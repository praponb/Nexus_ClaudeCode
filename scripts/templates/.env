# Canonical environment reference (design stack §12). PLACEMENT: intended for
# the REPOSITORY ROOT as `.env`; kept under backend/ (this is a checked-in,
# placeholder-only template, safe to commit) because the Cycle-2 workspace
# only permits writes under backend/ and scripts/.
# Copy to the repo root for local development:  cp backend/.env .env
# NEVER commit a real .env containing actual secrets.

# --- Application ---
APP_ENV=local
APP_BASE_URL=http://localhost:3000
DJANGO_SETTINGS_MODULE=config.settings.local
# Local dev placeholder only; generate a real secret for any real deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=local-dev-only-not-a-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Database (PostgreSQL only) ---
POSTGRES_DB=asset_inventory
POSTGRES_USER=asset_inventory
POSTGRES_PASSWORD=local-dev-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Auth (design D-01) ---
# Local session auth is the dev/test mode; production must use OIDC SSO.
LOCAL_AUTH_ENABLED=true
# LOCAL_AUTH_ALLOW_IN_PRODUCTION=false   # emergency override only, never commit true
SESSION_IDLE_SECONDS=1800
# OIDC_* (production target; deferred in v1)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=

# --- Celery / Redis (Cycle 2+) ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# --- Attachments (D-04) ---
MEDIA_ROOT=
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,webp,txt,csv,docx,xlsx
# Production object storage via django-storages (optional):
# STORAGES_BACKEND=s3
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=

# --- Frontend ---
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# --- Dev seeding (local only; printed once if left empty) ---
SEED_DEMO_PASSWORD=

# --- Observability ---
LOG_LEVEL=INFO
