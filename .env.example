# Copy to .env and fill in real values. Never commit the real .env file.

# --- Model provider configuration ---
# MODEL_PROVIDER selects how MODEL_NAME is resolved:
#   moonshot -> routed through litellm's built-in Moonshot AI provider as
#               "moonshot/<MODEL_NAME>" (https://api.moonshot.ai/v1). This is
#               the default and is what kimi-k3 requires.
#   litellm  -> MODEL_NAME is passed to litellm verbatim (use this for any
#               other provider/model litellm supports, e.g. "openai/gpt-4o").
#   fake     -> no network calls; uses the built-in deterministic test model.
#               Used by the orchestrator's own test suite / --dry-run smoke
#               checks so CI does not require paid API access.
MODEL_PROVIDER=moonshot

# kimi-k3 is a real, currently-shipping Moonshot AI model (confirmed against
# https://platform.kimi.ai/docs/guide/kimi-k3-quickstart). Do not change this
# to a different model name silently if kimi-k3 access is unavailable --
# instead fix MODEL_API_KEY/MODEL_API_BASE below, or explicitly choose a
# different MODEL_NAME you have access to.
MODEL_NAME=kimi-k3

# Optional. litellm's moonshot provider already defaults this to
# https://api.moonshot.ai/v1 -- only set it to point at a different
# OpenAI-compatible endpoint (e.g. a self-hosted proxy or test double).
MODEL_API_BASE=

# Required for any non-fake MODEL_PROVIDER. Create a key at
# https://platform.kimi.ai/console/api-keys (requires an account with at
# least a $1 top-up). Never commit this value.
MODEL_API_KEY=

# Optional. One of: low, high, max. Left unset uses the provider default.
MODEL_REASONING_EFFORT=

# --- Orchestrator configuration ---
AGENTIC_BUILDER_INPUT_DIR=./requirements
AGENTIC_BUILDER_WORKSPACE=.
AGENTIC_BUILDER_CYCLES=3
AGENTIC_BUILDER_LOG_LEVEL=INFO
