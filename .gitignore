# Python
__pycache__/
*.py[cod]
*.egg-info/
src/*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
adk-venv/

# Env / secrets
.env
.env.*
# scripts/export-app-env.sh writes the app-only secret bundle here before it is
# scp'd to the server. It does NOT match `.env.*`, so it needs its own line.
app.env
# scripts/sync-to-server.sh stamps the deployed commit into the tree just before
# rsync, so the server carries the SHA it is running. It must stay untracked, or
# every sync would dirty the tree it just checked was clean.
DEPLOYED_COMMIT
# Checked-in placeholder templates (no real secrets) -- see ADR-006.
!backend/.env
!scripts/templates/.env

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Claude Code local (per-machine) settings -- .claude/settings.json (shared) is still tracked
.claude/settings.local.json

# Orchestrator run artifacts (generated at run time, not source)
runs/*
!runs/.gitkeep

# Playwright MCP session artifacts (snapshots/screenshots written by the
# Playwright MCP server during interactive debugging, not test output)
.playwright-mcp/

# Backups
backups/
