# Python
__pycache__/
*.py[cod]
*.egg-info/
src/*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
adk-venv/

# Env / secrets
.env
.env.*
# Checked-in placeholder templates (no real secrets) -- see ADR-006.
!backend/.env
!scripts/templates/.env

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# OS
.DS_Store

# Claude Code local (per-machine) settings -- .claude/settings.json (shared) is still tracked
.claude/settings.local.json

# Orchestrator run artifacts (generated at run time, not source)
runs/*
!runs/.gitkeep
